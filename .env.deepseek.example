# DeepSeek OpenAI-compatible API profile.
# Copy to .env.deepseek for the explicit live test, or merge these values into .env.
PORT=4174
MODEL_API_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-your-deepseek-api-key
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT_MS=30000
MODEL_TASK_ROUTE_BUDGET_MS=30000
MODEL_RESPONSE_FORMAT_MODE=json_object
MODEL_THINKING_MODE=disabled
MODEL_TASK_MAX_OUTPUT_TOKENS=16384
MODEL_COACH_MAX_OUTPUT_TOKENS=8192
DATABASE_PATH=./data/time-management-deepseek.sqlite
SESSION_SECRET=replace-with-at-least-48-random-bytes-for-local-session-signing
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=604800000
